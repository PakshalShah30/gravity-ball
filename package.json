{
  "name": "gravity-ball",
  "version": "1.0.0",
  "private": true,
  "description": "Neon arcade breakout with gravity flips, chain multipliers and an absurd amount of juice. Zero dependencies, zero build step.",
  "type": "module",
  "license": "MIT",
  "keywords": ["game", "canvas", "breakout", "game-feel", "juice", "webaudio"],
  "scripts": {
    "start": "node tools/serve.mjs",
    "serve": "node tools/serve.mjs",
    "test": "node tools/lint.mjs && node tools/scenarios.mjs",
    "lint": "node tools/lint.mjs",
    "scenarios": "node tools/scenarios.mjs",
    "simulate": "node tools/harness.mjs --seconds 150",
    "shots": "node tools/harness.mjs --seconds 150 --shots out/shots"
  },
  "engines": {
    "node": ">=18"
  }
}
